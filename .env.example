# One settings file per site. Copy this file to .env.<site> (for example
# .env.myshop) and fill it in. The agent reads it when you pass --site myshop,
# or automatically on the git branch site/myshop. Values shared by every site
# can go in a plain .env instead; the site file wins when both set a value.
# Git ignores .env and every .env.<site>.

# Target app (required)
TARGET_URL=https://staging.your-app.com

# Optional: a test account, for sites with features behind a login.
# Use a dedicated test account on a test environment, never a real user's.
# Wrap the password in single quotes if it has spaces, # or quotes.
# The agent never sees these values: it types the names and the browser fills them in.
TEST_USERNAME=
TEST_PASSWORD=
# Optional: the sign-in page, if it is not easy to find from the navigation.
LOGIN_URL=

# Optional: other hosts the app needs, separated by commas (for example its API
# subdomain). The agent's browser blocks every host except the target and these.
ALLOWED_ORIGINS=

# Optional: routes the agent must leave alone, separated by commas (for example
# /internal,/api/billing). Each one covers everything under it. Nothing else is
# skipped, so an admin area you do not list here gets tested.
EXCLUDED_PATHS=

# Optional: run limits. A run that reaches either one is stopped, and what it
# wrote so far is kept. A turn is one step the agent takes, such as opening a
# page or writing a file. Left unset, generate gets 60 minutes and 500 turns,
# heal 30 and 300, check-login 5 and 40. Raise them for a large app.
MAX_MINUTES=
MAX_TURNS=

# Optional: how many times in a row the agent runs the finished suite to find
# flaky tests (tests that pass on one run and fail on the next). Left unset it
# is 3, and every report states a flaky count. 1 switches the check off.
STABILITY_RUNS=
