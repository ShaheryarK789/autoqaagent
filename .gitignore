node_modules/
# settings and credentials: the shared file and one per site
.env
.env.*
!.env.example
playwright-report/
test-results/
# saved sign-in sessions for the test account
.auth/
# per-run browser artifacts (screenshots, traces) are large; reports and events stay
runs/*/browser/
